# ===========================
# NelsonFxBot Environment File
# ===========================

# Bot Owner Number (with country code, no + sign)
OWNER_NUMBER=2349138567333

# Bot Name
BOT_NAME=NelsonFxBot

# Command Prefix
PREFIX=.

# Bot Mode (public = everyone can use | private = owner only | group = groups only)
BOT_MODE=public

# ===========================
# API KEYS (Free)
# ===========================

# Google Gemini AI (Free) - get at https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# OpenWeatherMap (Free) - get at https://openweathermap.org/api
WEATHER_API_KEY=your_weather_api_key_here

# NewsAPI (Free) - get at https://newsapi.org
NEWS_API_KEY=your_news_api_key_here

# Remove.bg (50 free/month) - get at https://www.remove.bg/api
REMOVEBG_API_KEY=your_removebg_api_key_here

# ===========================
# SESSION
# ===========================

# Session method: qr or pairing
SESSION_METHOD=qr

# Your bot's WhatsApp number (with country code, no + sign)
BOT_NUMBER=your_bot_whatsapp_number_here

# ===========================
# SETTINGS
# ===========================

# Auto read messages (true/false)
AUTO_READ=true

# Auto typing indicator (true/false)
AUTO_TYPING=true

# Auto recording indicator for audio (true/false)
AUTO_RECORDING=true

# Auto react to commands (true/false)
AUTO_REACT=true

# Daily auto restart time (24hr format)
AUTO_RESTART_TIME=03:00

# Bot version
BOT_VERSION=1.0.0
